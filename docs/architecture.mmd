---
config:
  theme: base
  themeVariables:
    primaryColor: "#0f172a"
    primaryTextColor: "#e2e8f0"
    primaryBorderColor: "#0063e5"
    lineColor: "#38bdf8"
    secondaryColor: "#1e293b"
    tertiaryColor: "#1e293b"
    clusterBkg: "#f0f7ff"
    clusterBorder: "#bfdbfe"
    edgeLabelBackground: "#e8f0ff"
    mainBkg: "#0f172a"
    nodeBorder: "#0063e5"
    titleColor: "#1e1b4b"
    fontFamily: "ui-sans-serif, system-ui, -apple-system, sans-serif"
    fontSize: "13px"
---
flowchart TB
    User([Planner]) --> HTML["index.html\nFormula, calendar, roster, board, flags"]

    subgraph Model["Model (pure, Node-tested)"]
        state["state.js\nPlan + normalizeDoc + undo per plan\nLater and Done"]
        calendar["calendar.js\nSprint dates, days off, focus days"]
        capacity["capacity.js\nFibonacci rounding, analyze()"]
        flags["flags.js\nMissing data, missing people, load"]
        calendar --> capacity --> flags
    end

    subgraph View["View and input (ES modules)"]
        app["app.js\nEntry point"]
        render["render*.js\nFormula, totals, roster,\ncards or table, flags"]
        dnd["dnd.js\nPointer drag, tap to carry"]
        events["events.js + popover.js\nClicks, keys, pickers"]
        actions["actions.js\nDrops and flag fixes"]
        io["io.js\nShare link, Markdown, JSON"]
    end

    HTML --> app --> render
    app --> events
    dnd -->|"drop"| actions
    events -->|"fix, carry"| actions
    actions -->|"snapshot, mutate"| state
    state -->|"afterChange()"| render
    render -->|"analyze(doc, cal)"| capacity
    render --> flags

    holidays["holidays.js\nOn-demand loader"] -->|"cal.holidays(CC, year)"| calendar
    holidays -->|"fetch, same origin"| Data[("data/holidays/CC.json\n207 countries, 2025 to 2030")]
    Build["tools/build-holidays.cjs\n(date-holidays, run once)"] -.->|"generates"| Data
    plans["plans.js\nEvery plan: open, switch,\ndelete, restore"]
    plans -->|"open, switch"| state
    plans <-->|"reparto-v1-plans"| Storage[("localStorage")]
    io -->|"a link or an import\nopens as a new plan"| plans
    io -->|"#p= fragment"| Link(["Share link"])
